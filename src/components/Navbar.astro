---

<div class="w-full" x-data="{ open : false }">
    <nav class="flex items-center justify-between p-6 md:p-10 bg-mocha-base">
        <a href="/portfolio">
            <h1 class="text-mocha-green text-4xl font-lily-script">
                J.J. Müller
            </h1>
        </a>

        <!-- Mobile Menu Button -->
        <button
            class="block lg:hidden text-mocha-text text-3xl focus:outline-none"
            @click="open = !open"
        >
            <i class="bi bi-list"></i>
        </button>

        <!-- Navbar Links -->
        <ul
            id="menu"
            class="hidden lg:flex text-mocha-text text-xl space-x-6 lg:space-x-10"
        >
            <li><a href="#about" class="hover:text-mocha-sky hover:font-bold">About</a></li>
            <li>
                <a href="#skills" class="hover:text-mocha-red hover:font-bold"
                    >Skills</a>
            </li>
            <li>
                <a href="#projects" class="hover:text-mocha-pink hover:font-bold"
                    >Projects</a>
            </li>
            <li>
                <a href="#experinece" class="hover:text-mocha-peach hover:font-bold">Experience</a>
            </li>
        </ul>

        <!-- Search Box -->
        <div class="relative hidden lg:block">
      <a href="https://www.linkedin.com/in/joël-julien-müller-27029222b" target="_blank">
            <i class="bi bi-linkedin text-3xl"></i>
          </a>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <ul
        class="hidden flex flex-col items-center h-screen bg-mocha-base w-full py-4 space-y-4 text-xl text-mocha-text lg:hidden"
        :class="{ 'hidden' : !open }"
    >
        <li><a href="#about" class="hover:text-mocha-green">About</a></li>
        <li>
            <a href="#skills" class="hover:text-mocha-green">Skills</a>
        </li>
        <li>
            <a href="#projects" class="hover:text-mocha-pink">Projects</a>
        </li>
        <li><a href="#experinece" class="hover:text-mocha-green">Experience</a></li>
    </ul>
</div>


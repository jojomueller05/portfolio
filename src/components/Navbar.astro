---
// Logo <> About, Portfolio, Contact <> Search...
// BG: Base
// Logo:
//  Entweder: RoseWater(#f5e0dc), Teal(#94e2d5), Mauve(#cba6f7)

// Favicon: 48x48
// logo navbar 40px mal 150px font: Lily Script One
---

<div class="w-full" 
     x-data="{ open : false }" 
     x-effect="open ? document.body.classList.add('overflow-hidden') : document.body.classList.remove('overflow-hidden')">
    
    <nav class="flex items-center justify-between p-6 md:p-10 bg-mocha-base">
        <a href="/portfolio">
            <h1 class="text-mocha-green text-4xl font-lily-script">
                J.J. Müller
            </h1>
        </a>

        <button
            class="block lg:hidden text-mocha-text text-3xl focus:outline-none z-50"
            @click="open = !open"
        >
            <i class="bi" :class="open ? 'bi-x-lg' : 'bi-list'"></i>
        </button>

        <ul
            id="menu"
            class="hidden lg:flex text-mocha-text text-xl space-x-6 lg:space-x-10"
        >
            <li><a href="#about" class="hover:text-mocha-sky hover:font-bold">About</a></li>
            <li><a href="#skills" class="hover:text-mocha-red hover:font-bold">Skills</a></li>
            <li><a href="#projects" class="hover:text-mocha-pink hover:font-bold">Projects</a></li>
            <li><a href="#experinece" class="hover:text-mocha-peach hover:font-bold">Experience</a></li>
        </ul>

        <div class="relative hidden lg:block">
            <a href="https://www.linkedin.com/in/joël-julien-müller-27029222b" target="_blank">
                <i class="bi bi-linkedin text-3xl text-mocha-text"></i>
            </a>
        </div>
    </nav>

    <div
        class="fixed inset-0 z-40 bg-mocha-base flex flex-col items-center justify-center lg:hidden transition-all duration-300"
        x-show="open"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 transform translate-x-full"
        x-transition:enter-end="opacity-100 transform translate-x-0"
        x-transition:leave="transition ease-in duration-300"
        x-transition:leave-start="opacity-100 transform translate-x-0"
        x-transition:leave-end="opacity-0 transform translate-x-full"
    >
        <ul class="flex flex-col items-center space-y-8 text-2xl text-mocha-text">
            <li><a href="#about" @click="open = false" class="hover:text-mocha-green">About</a></li>
            <li><a href="#skills" @click="open = false" class="hover:text-mocha-green">Skills</a></li>
            <li><a href="#projects" @click="open = false" class="hover:text-mocha-pink">Projects</a></li>
            <li><a href="#experinece" @click="open = false" class="hover:text-mocha-green">Experience</a></li>
            <li class="pt-4">
                <a href="https://www.linkedin.com/in/joël-julien-müller-27029222b" target="_blank">
                    <i class="bi bi-linkedin text-4xl"></i>
                </a>
            </li>
        </ul>
    </div>
</div>

---
const entries = [
    {
        date: "2021-2025",
        title: "Betriebsinformatiker EFZ",
        organisation: "Lehner-Versand AG, Schenkon Switzerland",
        description: "Entry into computer science...",
    },
    {
        date: "29.06.2026 - 22.04.2027",
        title: "Soldier",
        organisation: "Swiss Armed Forces",
        description: "Infantryman (Continuous Service)",
    },
];
---

<section id="experience" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-24 md:px-8 md:py-32">
    <div class="reveal mb-12 md:mb-16">
        <h2 class="text-3xl font-bold tracking-tight text-mocha-peach md:text-4xl">Experience</h2>
        <div class="mt-5 h-px w-16 bg-gradient-to-r from-mocha-peach/70 to-transparent"></div>
    </div>

    <div class="reveal mx-auto max-w-3xl [transition-delay:80ms]">
        <div class="grid grid-cols-[14px_1fr] gap-x-6 gap-y-6 md:gap-x-8 md:gap-y-8">
            {entries.map((entry, index) => (
                <Fragment>
                    <!-- Timeline rail -->
                    <div class="relative">
                        {index === entries.length - 1 ? (
                            <>
                                <!-- Orange progress up to the latest dot -->
                                <div
                                    aria-hidden="true"
                                    class="absolute left-1/2 top-0 h-[39px] w-0.5 -translate-x-1/2 rounded-full bg-mocha-peach"
                                ></div>
                                <!-- Grey fade below the latest dot -->
                                <div
                                    aria-hidden="true"
                                    class="absolute bottom-2 left-1/2 top-[39px] w-0.5 -translate-x-1/2 bg-gradient-to-b from-mocha-surface2 to-transparent"
                                ></div>
                                <span
                                    aria-hidden="true"
                                    class="absolute left-1/2 top-8 h-3.5 w-3.5 -translate-x-1/2 rounded-full bg-mocha-peach ring-4 ring-mocha-base"
                                ></span>
                            </>
                        ) : (
                            <div
                                aria-hidden="true"
                                class="absolute -bottom-6 left-1/2 top-2 w-0.5 -translate-x-1/2 rounded-full bg-mocha-peach md:-bottom-8"
                            ></div>
                        )}
                    </div>

                    <article class="rounded-2xl border border-mocha-surface1/70 bg-mocha-surface0/50 p-6 transition-colors duration-300 hover:border-mocha-peach/30 hover:bg-mocha-surface0 md:p-8">
                        <div class="mb-4 flex flex-wrap items-center gap-3">
                            <span class="rounded-full border border-mocha-peach/30 bg-mocha-peach/10 px-3 py-1 text-xs font-medium tracking-wide text-mocha-peach">
                                {entry.date}
                            </span>
                        </div>

                        <h3 class="text-xl font-semibold text-mocha-text md:text-2xl">
                            {entry.title}
                        </h3>
                        <p class="mt-1.5 text-sm text-mocha-subtext0 md:text-base">
                            {entry.organisation}
                        </p>
                        {entry.description && (
                            <p class="mt-4 leading-relaxed text-mocha-subtext1">
                                {entry.description}
                            </p>
                        )}
                    </article>
                </Fragment>
            ))}
        </div>
    </div>
</section>
